# AI-OmniRouter - Configuração de Provedores

# Host e Porta do Servidor
PORT=8000
HOST="0.0.0.0"

# Modo de Decisão Padrão: balanced | cost_saving | quality_first
DEFAULT_ROUTING_STRATEGY="balanced"

# Provedor Local Gratuito (Ollama / vLLM / LocalAI)
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_MODEL_CODE="qwen2.5-coder:1.5b"
LOCAL_MODEL_FAST="llama3.2:1b"
LOCAL_MODEL_REASONING="deepseek-r1:1.5b"

# Provedores em Nuvem (Preencha as que desejar utilizar)
# Google Gemini (Possui tier gratuito generoso para Gemini 1.5 Flash / Flash Lite)
GEMINI_API_KEY=""

# OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=""

# Anthropic (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=""

# Groq (Tier gratuito ultra-rápido para Llama 3.3 70B, DeepSeek)
GROQ_API_KEY=""

# OpenRouter (Opcional - caso queira usar como fallback unificado)
OPENROUTER_API_KEY=""
